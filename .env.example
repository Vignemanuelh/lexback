# ==============================================================================
# LEXBENIN - Assistant Numérique Citoyen (Configuration d'environnement)
# ==============================================================================

PROJECT_NAME="LEXBENIN - Assistant Numérique Citoyen"
ENVIRONMENT=development
DEBUG=True
API_V1_STR=/api/v1
SECRET_KEY=super_secret_key_change_in_production_min_32_characters

# --- Base de données PostgreSQL (avec extension pgvector) ---
POSTGRES_USER=lexbenin
POSTGRES_PASSWORD=lexbenin_secret_pass
POSTGRES_DB=lexbenin_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://lexbenin:lexbenin_secret_pass@localhost:5432/lexbenin_db
DATABASE_SYNC_URL=postgresql+psycopg2://lexbenin:lexbenin_secret_pass@localhost:5432/lexbenin_db

# --- Cache & File asynchrone (Redis) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# --- IA : Google Gemini Developer API ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_TEXT_MODEL=gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# --- Observabilité & Tracing : Langfuse ---
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# --- Intégration WhatsApp Cloud API (Meta) ---
WHATSAPP_VERIFY_TOKEN=lexbenin_webhook_verify_token
WHATSAPP_APP_SECRET=your_meta_app_secret_here
WHATSAPP_ACCESS_TOKEN=your_meta_system_user_access_token
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_API_VERSION=v21.0

# --- Sécurité production (valeurs fournies par Vault en production) ---
SECRET_KEY=CHANGE_ME_min_32_chars_random
CORS_ORIGINS=https://lexbenin.emmanuelhoudji.com
ENABLE_API_DOCS=false
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_min_12_chars
ADMIN_API_KEY=CHANGE_ME_long_random_key
# Mettre true avec le pooler transactionnel Supabase (port 6543)
DATABASE_DISABLE_STATEMENT_CACHE=false
PARTNER_API_KEY=CHANGE_ME_min_20_chars_random
